{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vibethema Charm collection",
  "type": "object",
  "required": ["version", "sourceId", "kind", "charms"],
  "properties": {
    "$schema": {"type": "string"},
    "version": {"const": "0.3.0"},
    "sourceId": {"type": "string", "minLength": 1},
    "kind": {"enum": ["exalted", "martialArts", "evocation"]},
    "exaltType": {"enum": ["SOLAR", "LUNAR", "SIDEREAL", "ABYSSAL", "DRAGON_BLOODED", "LIMINAL", "GETHIMANU", "EXIGENT"]},
    "id": {"type": "string"},
    "ability": {"type": "string", "minLength": 1},
    "artifactId": {"type": "string", "minLength": 1},
    "artifactName": {"type": "string"},
    "charms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "kind": false, "exaltType": false, "sourceId": false,
          "ability": false, "artifactId": false,
          "category": false, "exalt": false, "exaltTypes": false
        }
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {"if": {"properties": {"kind": {"const": "exalted"}}},
     "then": {"required": ["exaltType", "ability"], "properties": {"artifactId": false, "artifactName": false}}},
    {"if": {"properties": {"kind": {"const": "martialArts"}}},
     "then": {"required": ["ability"], "properties": {"exaltType": false, "artifactId": false, "artifactName": false}}},
    {"if": {"properties": {"kind": {"const": "evocation"}}},
     "then": {"required": ["artifactId"], "properties": {"exaltType": false, "ability": false}}}
  ]
}
